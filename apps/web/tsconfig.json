{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": false, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "baseUrl": ".",
    "paths": { "@localle/shared/*": ["../../packages/shared/src/*"] }
  },
  "include": ["src"]
}
