# API da plataforma de rastreamento. Sem prefixo VITE_: a chave fica só no proxy do Vite.
# VITE_RASTREIO_ON=true liga a integração.
VITE_RASTREIO_ON=false
RASTREIO_API_URL=https://rastreamento.ong.br
RASTREIO_API_KEY=cole-aqui-a-chave-da-api

# Nosso backend (apps/api): login (sempre real) e frota ao vivo. O Vite repassa /api-localle para cá.
LOCALLE_API_URL=http://localhost:3000
