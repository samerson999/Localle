# Copie para .env. Aponta para infra/plataforma (pgbouncer na porta 6432) em desenvolvimento local.
DATABASE_URL=postgres://plataforma:troque-esta-senha@localhost:6432/plataforma
PORT=3000
JWT_SECRET=troque-este-segredo

# Migrations na subida da imagem (scripts/start-prod.sh): conexão DIRETA ao Postgres, não pelo PgBouncer
# (a trava do node-pg-migrate não funciona em pool por transação). Sem ela, usa DATABASE_URL sem trava.
# MIGRATION_DATABASE_URL=postgres://plataforma:troque-esta-senha@localhost:5432/plataforma

# Redis (infra/fila) — só o tempo real do mapa (pub/sub). A fila de posições é o ingest_inbox, no Postgres.
REDIS_URL=redis://:troque-esta-senha@localhost:6379

# Traccar (infra/traccar). Sem estas três, o polling fica desligado (log na subida, sem erro).
# TRACCAR_URL=http://localhost:8082
# TRACCAR_USER=admin
# TRACCAR_PASSWORD=troque-esta-senha
# TRACCAR_POLL_INTERVAL_MS=30000
# Com o Forwarding e a conciliação ligados (abaixo), o polling é redundante (só traz a última posição): desligue com false.
# TRACCAR_POLL_ENABLED=false
# TRACCAR_TIMEOUT_MS=15000          # tempo limite de cada chamada ao Traccar

# Forwarding do Traccar → POST /ingest/traccar/positions e /events (docs/ARQUITETURA-INTEGRACAO-TRACCAR.md § 5.1).
# Mesma chave do forward.header no traccar.xml (infra/traccar). Sem ela, os endpoints recusam tudo (401).
# TRACCAR_INGEST_KEY=troque-esta-chave
# INBOX_WORKER_ENABLED=false   # desliga o consumo do inbox nesta instância (padrão: ligado)
# INBOX_FAIXAS=1                # faixas paralelas do consumo (mesmo rastreador sempre na mesma); DATABASE_POOL_MAX acima disto
# INGEST_DEDUP_DIAS=14          # quanto tempo o controle de duplicidade guarda o que já foi recebido (limpeza de hora em hora)

# Conciliação com o Traccar (src/ingest/conciliacao.service.ts): busca pelo REST do Traccar (TRACCAR_URL/USER/PASSWORD acima)
# as posições que o Forwarding não entregou e põe no inbox. Desligada por padrão. Valores abaixo são os padrões.
# CONCILIACAO_ENABLED=true
# CONCILIACAO_INTERVALO_MS=300000   # pausa entre o fim de uma volta e o começo da próxima
# CONCILIACAO_ATRASO_S=120          # só confere fixTime mais velho que isto (o Forwarding entrega primeiro)
# CONCILIACAO_SOBREPOSICAO_S=600    # ao retomar, recomeça este tanto antes do checkpoint
# CONCILIACAO_JANELA_MAX_H=6        # maior janela por consulta ao Traccar
# CONCILIACAO_INICIO_H=24           # rastreador sem checkpoint começa em agora − isto
# CONCILIACAO_MAX_PENDENTES=5000    # freio: recuperadas esperando no inbox acima disto pausam a volta
# CONCILIACAO_PAUSA_MS=100          # entre consultas ao Traccar
# CONCILIACAO_TIMEOUT_MS=30000      # por consulta ao Traccar
# RETENCAO_JOB_ENABLED=false   # desliga a retenção diária por plano (apaga posições/eventos vencidos por cliente)
# COMANDOS_EXPIRER_ENABLED=false   # desliga o job que expira comandos sem commandResult (padrão: ligado)

# E-mail transacional (convite de primeiro acesso). Sem SMTP_HOST/SMTP_FROM, o envio fica desligado (log
# de aviso) e o convite pode ser reenviado pelo painel depois. Em dev, infra/mail sobe o Mailpit:
# SMTP em localhost:1025, caixa de entrada em http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=Localle <nao-responda@localle.dev>
# Origem pública do front — base do link do convite (HashRouter: <APP_URL>/#/convite/<token>).
APP_URL=http://localhost:5174

# Notificações push — Web Push/VAPID (docs/PLANO-APK-TWA.md § 2). Sem as duas chaves, o módulo fica
# "existe mas inativo": GET /notificacoes/chave-publica devolve 503, sem derrubar o resto da API.
# Gerar uma vez com `node -e "console.log(require('web-push').generateVAPIDKeys())"` e NUNCA trocar depois
# (invalidaria toda assinatura de push já registrada nos aparelhos). Um par por ambiente (dev/HML/produção).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:suporte@localle.com.br
