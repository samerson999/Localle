# Copie para .env. Aponta para infra/plataforma (pgbouncer na porta 6432) em desenvolvimento local.
DATABASE_URL=postgres://plataforma:troque-esta-senha@localhost:6432/plataforma
PORT=3000
JWT_SECRET=troque-este-segredo

# Fila (infra/fila) — BullMQ/Redis entre o polling do Traccar e a gravação no Postgres.
REDIS_URL=redis://:troque-esta-senha@localhost:6379

# Traccar (infra/traccar). Sem estas três, o polling fica desligado (log na subida, sem erro).
# TRACCAR_URL=http://localhost:8082
# TRACCAR_USER=admin
# TRACCAR_PASSWORD=troque-esta-senha
# TRACCAR_POLL_INTERVAL_MS=30000
# Com o Forwarding do Traccar ligado (abaixo), o polling é redundante: desligue com false.
# TRACCAR_POLL_ENABLED=false

# Forwarding do Traccar → POST /ingest/traccar/positions e /events (docs/ARQUITETURA-INTEGRACAO-TRACCAR.md § 5.1).
# Mesma chave do forward.header no traccar.xml (infra/traccar). Sem ela, os endpoints recusam tudo (401).
# TRACCAR_INGEST_KEY=troque-esta-chave
# INBOX_WORKER_ENABLED=false   # desliga o consumo do inbox nesta instância (padrão: ligado)

# E-mail transacional (convite de primeiro acesso). Sem SMTP_HOST/SMTP_FROM, o envio fica desligado (log
# de aviso) e o convite pode ser reenviado pelo painel depois. Em dev, infra/mail sobe o Mailpit:
# SMTP em localhost:1025, caixa de entrada em http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=Localle <nao-responda@localle.dev>
# Origem pública do front — base do link do convite (HashRouter: <APP_URL>/#/convite/<token>).
APP_URL=http://localhost:5174
