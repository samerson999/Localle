{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "removeComments": true,
    "incremental": false,
    "rootDir": "./migrations",
    "outDir": "./dist-migrations"
  },
  "include": ["migrations"]
}
