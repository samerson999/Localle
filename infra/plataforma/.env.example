# Copie para .env e troque a senha antes de "docker compose up".
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=troque-esta-senha
TZ=America/Recife
# Endereço:porta publicados no host (padrão só no localhost). 0.0.0.0 expõe o banco na rede — só com firewall na frente.
# DB_HOST_PORT=127.0.0.1:5432
# PGBOUNCER_HOST_PORT=127.0.0.1:6432
